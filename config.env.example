# Copy this file to config.env and fill in your values.
# chmod 600 config.env

# Cursor Teams Admin API key (cursor.com/dashboard → API Keys)
# Note: User/Agent keys work on /v1/me but NOT on /teams/spend.
# Use an Admin API key with admin:* scope, or leave AUTH_MODE=session.
CURSOR_API_KEY=crsr_your_api_key_here

# Your Cursor account email (required for Admin API; optional for session mode)
CURSOR_EMAIL=you@example.com

# Auth mode: auto | admin | session
# auto   = try Admin API first, then fall back to Cursor app session (recommended)
# admin  = Admin API only (requires Teams Admin key with admin:* scope)
# session = use signed-in Cursor app session only (works with User/Agent keys absent)
AUTH_MODE=session

# Optional manual session override (browser cookie WorkosCursorSessionToken)
# CURSOR_SESSION_TOKEN=user_xxx::eyJ...

# Overlay position:
# bottom-right, bottom-left, top-right, top-left,
# center-center (or center), top-center, bottom-center, center-left, center-right
OVERLAY_POSITION=bottom-right

# Panel opacity 0.0–1.0
OVERLAY_OPACITY=0.6

# Update interval in seconds (3600 = hourly; minimum recommended: 900)
UPDATE_INTERVAL=3600
